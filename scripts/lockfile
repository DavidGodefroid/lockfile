#!/bin/sh
# lockfile: the launcher. lockfile runs in Docker; this script, installed as
# `lockfile` on the host by scripts/install.sh, runs every command in the
# image, each with the account and the volumes it needs (docs/docker.md):
#
#   console          as the console account (lockfile), in a container of
#                    its own per profile (lockfile-console-<n>), under the
#                    shipped seccomp profile, confined (no capability,
#                    read-only root, bounded processes and memory), with
#                    the socket and home volumes
#   profile, marketplace
#                    as you, with the workspace's profile directory
#                    (<workspace>/.lockfile, the nearest directory up from
#                    here that holds .lockfamily/, else this one; profile
#                    add --project DIR names another): `lox up`
#                    reviews it and copies it, read-only, to the console's
#                    ~/.config/lockfile
#   plugin, audit, forget, doctor
#                    as the console account, with the home volume of the
#                    console `lox up` runs (--instance NAME picks one of
#                    several) and its reviewed profile copy, read-only
#                    (doctor also under the seccomp profile, with lox up's
#                    socket volume, read-only, as below; without lox up it
#                    runs without them and says why)
#   init, doctor --fix
#                    as you, with your home and the project: they write
#                    your agents' files
#   mcp, status, sources, plugins, plan, run, answers, release
#                    as the agent account (agent), with the socket volume of
#                    the workspace's lockfile lock that `lox up` runs (read
#                    from .lockfamily/up.json and checked with Docker;
#                    --instance NAME picks one of several), read-only, and
#                    nothing else; none without lox up (doctor then runs
#                    without one and says why)
#   anything else    as the agent account, with no volume: help...
#
# `lockfile update` updates this launcher, its seccomp profile and its
# image; `lockfile version` prints the launcher's and the image's versions.
#
# Environment:
#   LOCKFILE_IMAGE        image to run (default: the release image of this
#                         launcher's version; `lockfile` for a launcher run
#                         from a clone, the tag of `docker build -t lockfile .`)
#   LOCKFILE_VAULT=1      the image with the vault CLI (credentials = "vault")
#   LOCKFILE_DOCKER_ARGS  extra `docker run` arguments, split on spaces
#                         (e.g. -v /data/samples:/srv/lockfile/samples:ro)
#   LOCKFILE_CONSOLE_NAME the console's container name
#   VAULT_ADDR, VAULT_NAMESPACE, VAULT_CACERT  passed to the console (the
#                         file of VAULT_CACERT mounted read-only)
set -eu

# scripts/install.sh and lockfile update write the release version here,
# the digests of its images once their cosign signatures verify (the
# launcher then runs the image by digest, never by a tag that could move),
# and where they installed the seccomp profile.
launcher_version=dev
image_digest=
vault_image_digest=
seccomp_profile=

repo="DavidGodefroid/lockfile"
registry="ghcr.io/davidgodefroid/lockfile"

say() { printf 'lockfile: %s\n' "$*" >&2; }
die() {
	say "$*"
	exit 1
}

image="${LOCKFILE_IMAGE:-}"
if [ -z "$image" ]; then
	if [ "$launcher_version" = dev ]; then
		image=lockfile
	else
		image="$registry:$launcher_version"
	fi
	if [ "$launcher_version" != dev ] && [ -n "$image_digest" ]; then
		image="$registry@$image_digest"
		[ "${LOCKFILE_VAULT:-0}" = 1 ] && image="$registry@$vault_image_digest"
	elif [ "${LOCKFILE_VAULT:-0}" = 1 ]; then
		case "$image" in
		*:*) image="$image-vault" ;;
		*) image="$image:vault" ;;
		esac
	fi
fi

# The seccomp profile of the console's container: the one installed with
# this launcher, or the clone's seccomp.json next to scripts/.
if [ -z "$seccomp_profile" ]; then
	seccomp_profile="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd -P)/seccomp.json"
fi

tty=-i
if [ -t 0 ] && [ -t 1 ]; then tty=-it; fi

# docker_run ARGS...: docker run, then LOCKFILE_DOCKER_ARGS, then ARGS (the
# account, the volumes, the image and its command).
docker_run() {
	command -v docker >/dev/null 2>&1 || die "docker is required: lockfile runs in Docker (docs/docker.md)"
	# LOCKFILE_DOCKER_ARGS is split on spaces, never globbed.
	set -f
	# shellcheck disable=SC2086 # LOCKFILE_DOCKER_ARGS is split on purpose
	exec docker run --rm ${LOCKFILE_DOCKER_ARGS:-} "$@"
}

# migrate_ids VOLUME...: give the files of the volumes, made by a release
# before 0.3 with locksql's account ids (10000-10002), lockfile's own
# (10030-10032). Idempotent; root in the container with CAP_CHOWN and
# CAP_DAC_READ_SEARCH only, no network. Stays for one release.
migrate_ids() {
	command -v docker >/dev/null 2>&1 || die "docker is required: lockfile runs in Docker (docs/docker.md)"
	seccomp
	set -- --security-opt seccomp="$seccomp_profile" --cap-drop=ALL --cap-add=CHOWN --cap-add=DAC_READ_SEARCH \
		--security-opt no-new-privileges --read-only --network none --user 0:0 "$@"
	docker run --rm "$@" "$image" migrate-ids || die "could not move the volumes to the account ids 10030-10032"
}

# mountable PATH: PATH can be a docker -v source and target, which ":"
# separates.
mountable() {
	case "$1" in
	*:*) die "$1 holds a \":\", which docker -v cannot mount: move or rename it" ;;
	esac
}

# flag_value FLAG ARGS...: the value of FLAG V or FLAG=V in ARGS.
flag_value() {
	f=$1
	shift
	while [ $# -gt 0 ]; do
		case "$1" in
		"$f"=*)
			printf '%s' "${1#*=}"
			return
			;;
		"$f")
			printf '%s' "${2:-}"
			return
			;;
		esac
		shift
	done
}

# seccomp: the --security-opt of the console's containers. Never
# unconfined: without the profile the launcher stops.
seccomp() {
	[ -f "$seccomp_profile" ] || die "no seccomp profile at $seccomp_profile: reinstall the launcher (scripts/install.sh); lockfile never runs the console seccomp=unconfined"
}

# has_flag FLAG ARGS...: whether ARGS hold FLAG or FLAG=...
has_flag() {
	f=$1
	shift
	for a in "$@"; do
		case "$a" in "$f" | "$f"=*) return 0 ;; esac
	done
	return 1
}

# as_you ARGS...: run as you, with your home and the project (the nearest
# directory up from here that holds .lockfile/ or else .git, or this
# directory) mounted at their own paths, from this directory.
as_you() {
	here="$(pwd -P)"
	project="$here"
	d="$here"
	while :; do
		if [ -d "$d/.lockfile" ]; then
			project="$d"
			break
		fi
		[ "$d" = / ] && break
		d="$(dirname "$d")"
	done
	if [ "$project" = "$here" ] && [ ! -d "$here/.lockfile" ]; then
		d="$here"
		while :; do
			if [ -e "$d/.git" ]; then
				project="$d"
				break
			fi
			[ "$d" = / ] && break
			d="$(dirname "$d")"
		done
	fi
	mountable "$HOME"
	mountable "$project"
	mountable "$here"
	docker_run "$tty" --user "$(id -u):$(id -g)" -e HOME="$HOME" -v "$HOME:$HOME" \
		-v "$project:$project" -w "$here" "$image" "$@"
}

# release_identity TAG: the release workflow run on that very tag, as a
# regexp with its dots escaped: a validly signed older release cannot be
# passed off as this one.
release_identity() {
	printf '^https://github\\.com/DavidGodefroid/lockfile/\\.github/workflows/release\\.yml@refs/tags/%s$' "$(printf '%s' "$1" | sed 's/\./\\./g')"
}

# verified_digest TAG: the digest of the release image registry:TAG, once
# cosign verifies its signature by the release workflow run for $identity;
# empty when it does not verify.
verified_digest() {
	cosign verify --certificate-identity-regexp "$identity" \
		--certificate-oidc-issuer https://token.actions.githubusercontent.com \
		"$registry:$1" 2>/dev/null |
		sed -n 's/.*"docker-manifest-digest":"\(sha256:[0-9a-f]\{64\}\)".*/\1/p' | sed -n 1p
}

# update [vX.Y.Z]: replace this launcher and its seccomp profile with a
# release's (the cosign signature of checksums.txt and the archive's
# checksum checked, as scripts/install.sh does), then pull that release's
# image, by the digest its cosign signature verifies.
update() {
	command -v cosign >/dev/null 2>&1 ||
		die "cosign is required to check the release signature: https://docs.sigstore.dev/cosign/system_config/installation/"
	if command -v curl >/dev/null 2>&1; then
		fetch() { curl -fsSL -o "$2" "$1"; }
		latest() { curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/$repo/releases/latest"; }
	elif command -v wget >/dev/null 2>&1; then
		fetch() { wget -q -O "$2" "$1"; }
		latest() { wget -q -S --spider "https://github.com/$repo/releases/latest" 2>&1 | sed -n 's/^ *[Ll]ocation: *//p' | tail -n 1 | tr -d '\r'; }
	else
		die "curl or wget is required"
	fi
	case "$(uname -s)" in
	Linux) os=linux ;;
	Darwin) os=darwin ;;
	*) die "unsupported OS $(uname -s): Linux and macOS only (WSL 2 on Windows)" ;;
	esac
	case "$(uname -m)" in
	x86_64 | amd64) arch=amd64 ;;
	aarch64 | arm64) arch=arm64 ;;
	*) die "unsupported architecture $(uname -m): amd64 and arm64 only" ;;
	esac

	tag="${1:-}"
	if [ -z "$tag" ]; then
		tag="$(latest)"
		tag="${tag##*/}"
		case "$tag" in
		v[0-9]*) ;;
		*) die "no published release found; name one: lockfile update vX.Y.Z" ;;
		esac
	fi
	case "$tag" in v*) ;; *) tag="v$tag" ;; esac
	version="${tag#v}"
	# An exact vX.Y.Z: the tag goes into the signer identity.
	case "$version" in
	'' | *[!0-9.]* | .* | *. | *..*) die "invalid release tag $tag" ;;
	esac
	[ "$(printf '%s' "$version" | tr -cd . | wc -c | tr -d ' ')" = 2 ] || die "invalid release tag $tag"
	identity="$(release_identity "$tag")"
	if [ "$version" = "$launcher_version" ]; then
		say "the launcher is already $tag"
	else
		self="$(command -v "$0" 2>/dev/null || printf '%s' "$0")"
		archive="lockfile_${version}_${os}_${arch}.tar.gz"
		base="https://github.com/$repo/releases/download/$tag"
		tmp="$(mktemp -d)"
		trap 'rm -rf "$tmp"' EXIT INT TERM
		say "downloading $archive ($tag)"
		fetch "$base/checksums.txt" "$tmp/checksums.txt" || die "download failed: checksums.txt"
		fetch "$base/checksums.txt.sigstore.json" "$tmp/checksums.txt.sigstore.json" ||
			die "download failed: checksums.txt.sigstore.json"
		cosign verify-blob --bundle "$tmp/checksums.txt.sigstore.json" \
			--certificate-identity-regexp "$identity" \
			--certificate-oidc-issuer https://token.actions.githubusercontent.com \
			"$tmp/checksums.txt" >/dev/null 2>&1 || die "cosign: checksums.txt is not signed by lockfile's release workflow; nothing updated"
		say "cosign: checksums.txt signature verified"
		fetch "$base/$archive" "$tmp/$archive" || die "download failed: $base/$archive"
		want="$(awk -v f="$archive" '$2 == f { print $1 }' "$tmp/checksums.txt")"
		[ -n "$want" ] || die "$archive is not listed in checksums.txt"
		if command -v sha256sum >/dev/null 2>&1; then
			got="$(sha256sum "$tmp/$archive" | awk '{ print $1 }')"
		else
			got="$(shasum -a 256 "$tmp/$archive" | awk '{ print $1 }')"
		fi
		[ "$want" = "$got" ] || die "checksum mismatch for $archive; nothing updated"
		tar -xzf "$tmp/$archive" -C "$tmp" scripts/lockfile seccomp.json 2>/dev/null ||
			die "$archive holds no launcher (scripts/lockfile, seccomp.json): $tag predates the Docker launcher"
		digest="$(verified_digest "$version")"
		vdigest="$(verified_digest "$version-vault")"
		[ -n "$digest" ] && [ -n "$vdigest" ] && [ "$digest" != "$vdigest" ] ||
			die "cosign: the signature of $registry:$version (and -vault) does not verify, or the image is not published yet"
		say "cosign: image $registry:$version verified ($digest)"
		profile="$seccomp_profile"
		sed -e "s/^launcher_version=dev\$/launcher_version=$version/" \
			-e "s/^image_digest=\$/image_digest=$digest/" \
			-e "s/^vault_image_digest=\$/vault_image_digest=$vdigest/" \
			-e "s|^seccomp_profile=\$|seccomp_profile=$profile|" \
			"$tmp/scripts/lockfile" >"$tmp/launcher"
		grep -qx "launcher_version=$version" "$tmp/launcher" || die "the launcher of $tag does not take its version"
		if [ -w "$self" ] && { [ -w "$profile" ] || [ -w "$(dirname "$profile")" ]; }; then
			install -m 0644 "$tmp/seccomp.json" "$profile"
			install -m 0755 "$tmp/launcher" "$self"
		else
			command -v sudo >/dev/null 2>&1 || die "$self is not writable and sudo is missing"
			say "replacing $self and $profile with sudo"
			sudo install -D -m 0644 "$tmp/seccomp.json" "$profile"
			sudo install -m 0755 "$tmp/launcher" "$self"
		fi
		say "launcher updated to $tag ($self)"
		image="$registry@$digest"
		[ "${LOCKFILE_VAULT:-0}" = 1 ] && image="$registry@$vdigest"
		[ -n "${LOCKFILE_IMAGE:-}" ] && say "LOCKFILE_IMAGE is set ($LOCKFILE_IMAGE): it still overrides $image"
	fi
	command -v docker >/dev/null 2>&1 || die "docker is required: lockfile runs in Docker (docs/docker.md)"
	say "pulling $image"
	exec docker pull "$image"
}

# The agent commands look for lox up's state from here up.
here="$(pwd -P)"

# Locks started by `lox up` (lockhub's docs/lox-up.md): `lox up` runs each
# lock's console under compose, with its socket in the volume
# lockfamily-<sha256 of the workspace, 8 hex>_<instance>-run, and names it
# in <workspace>/.lockfamily/up.json. The agent commands mount that volume
# read-only on /run/lockfile (connecting needs no write), never a fixed one:
# the consoles run hub-attached only, started by `lox up`. The checks are
# those of lea, which mounts the same volumes for its agents: up.json is
# the user's own regular file (no link) that no one else can write, in a
# .lockfamily of the same kind, of this very workspace; then Docker must
# confirm the volume: lox up's labels (project, role socket, instance,
# type, workspace), and every container that mounts it is lox up's (run
# by compose from lox up's own state directory) or mounts it read-only.
# These checks catch mistakes and files others can write; an agent that
# runs as you with Docker access gets past any of them (docs/launcher.md).
# up.json only names the instance:
# what is mounted is what Docker's labels prove, read as JSON, compared
# whole; anything else fails closed.

# json_safe S: S holds nothing JSON escapes (a quote, a backslash, a
# control character, U+2028, U+2029): "S" is then its JSON encoding.
json_safe() {
	case "$1" in *'"'* | *'\'* | *"$(printf '\342\200\250')"* | *"$(printf '\342\200\251')"*) return 1 ;; esac
	[ "$(printf '%s' "$1" | LC_ALL=C tr -d '\001-\037')" = "$1" ]
}

# private PATH: PATH is no link, is the user's, and neither its group nor
# others may write it.
private() {
	[ ! -L "$1" ] && [ "$(ls -nd "$1" | awk '{ print $3 }')" = "$(id -u)" ] &&
		[ -z "$(find "$1" -prune \( -perm -0020 -o -perm -0002 \) -print)" ]
}

# sha8 S: the first 8 hex digits of the sha256 of S (lox up's project).
sha8() {
	if command -v sha256sum >/dev/null 2>&1; then
		printf '%s' "$1" | sha256sum
	else
		printf '%s' "$1" | shasum -a 256
	fi | awk '{ print substr($1, 1, 8) }'
}

# lockup_parse < up.json: lox up's state (version 1, written by Go's
# json.MarshalIndent with a two-space indent): a line Pproject, a line
# Wworkspace, then a line Lname socket_volume client_gid per lock of type
# lockfile. Fails on anything else, or on a value it would have to unescape.
lockup_parse() {
	awk -v want=lockfile '
	function str(v) {
		if (v !~ /^"[^"\\]*"$/ || v ~ /[\001-\037]/) { bad = 1; return "" }
		return substr(v, 2, length(v) - 2)
	}
	{ line = $0 }
	NR == 1 { if (line != "{") bad = 1; next }
	{ last = line; match(line, /^ */); ind = RLENGTH; rest = substr(line, ind + 1) }
	rest == "}" || rest == "}," {
		if (inlocks && ind == 4) cur = ""
		else if (inlocks && ind == 2) inlocks = 0
		next
	}
	rest !~ /^"[^"\\]*": / { next }
	{
		k = substr(rest, 2, index(rest, "\":") - 2)
		v = substr(rest, length(k) + 5)
		sub(/,$/, "", v)
	}
	!inlocks && ind == 2 {
		if (k == "version") version = v
		else if (k == "project") project = str(v)
		else if (k == "workspace") workspace = str(v)
		else if (k == "locks") { if (v == "{") inlocks = 1; else if (v != "{}") bad = 1; locks = 1 }
		next
	}
	inlocks && ind == 4 {
		if (v != "{" || (k in seen)) bad = 1
		seen[k] = 1; cur = k; n++; name[n] = k
		next
	}
	inlocks && ind == 6 && cur != "" {
		if (k == "type" || k == "socket_volume" || k == "client_gid") f[cur, k] = str(v)
	}
	END {
		if (bad || last != "}" || inlocks || !locks || version != "1") exit 1
		print "P" project
		print "W" workspace
		for (i = 1; i <= n; i++) {
			c = name[i]
			if (f[c, "type"] != want) continue
			if (c !~ /^[a-z0-9][a-z0-9-]*$/ || length(c) > 63 || f[c, "socket_volume"] !~ /^[a-z0-9][a-z0-9_.-]*$/ || f[c, "client_gid"] !~ /^[0-9]*$/) exit 1
			print "L" c " " f[c, "socket_volume"] " " f[c, "client_gid"]
		}
	}'
}

# lockup_volume [INSTANCE]: the socket volume of the lockfile lock (INSTANCE,
# the only one without it) that `lox up` runs for the workspace of this
# directory, in $lockup_vol; when there is none the agents can trust, why,
# with what to do, in $lockup_why.
lockup_volume() {
	lockup_vol= lockup_why=
	lu_inst=${1:-}
	if [ -z "$here" ]; then
		lockup_why="the current directory no longer exists: cd to the workspace"
		return 1
	fi
	# The workspace: the nearest directory up from here whose .lockfamily
	# holds up.json (a sub-project's own .lockfamily may hold none).
	lu_ws=
	lu_d=$here
	while :; do
		if [ -e "$lu_d/.lockfamily/up.json" ] || [ -L "$lu_d/.lockfamily/up.json" ] || [ -L "$lu_d/.lockfamily" ]; then
			lu_ws=$lu_d
			break
		fi
		[ "$lu_d" = / ] && break
		lu_d=$(dirname "$lu_d")
	done
	if [ -z "$lu_ws" ]; then
		lockup_why="no .lockfamily/up.json in $here or above it: start the workspace's locks with \`lox up\` (lockhub), then run lockfile from the workspace"
		return 1
	fi
	lu_lf=$lu_ws/.lockfamily
	lu_f=$lu_lf/up.json
	if [ -L "$lu_lf" ] || [ ! -d "$lu_lf" ]; then
		lockup_why="$lu_lf is not a directory (a link?): it is not lox up's; run \`lox up\`"
		return 1
	fi
	if ! private "$lu_lf"; then
		lockup_why="$lu_lf is not yours, or others than you may write it: lockfile trusts none of it (chmod go-w it, then run \`lox up\`)"
		return 1
	fi
	if [ -L "$lu_f" ] || [ ! -f "$lu_f" ]; then
		lockup_why="$lu_f is not a regular file (a link?): it is not lox up's; run \`lox up\`"
		return 1
	fi
	if ! private "$lu_f"; then
		lockup_why="$lu_f is not yours, or others than you may write it: lockfile trusts none of it; run \`lox up\`"
		return 1
	fi
	if [ "$(wc -c <"$lu_f")" -gt 1048576 ]; then
		lockup_why="$lu_f is larger than 1 MiB: it is not lox up's; run \`lox up\`"
		return 1
	fi
	lu_ino=$(ls -di "$lu_f")
	if ! lu_state=$(lockup_parse <"$lu_f") || [ -L "$lu_f" ] || [ "$(ls -di "$lu_f")" != "$lu_ino" ]; then
		lockup_why="$lu_f is not lox up's state (version 1): run \`lox up\`"
		return 1
	fi
	lu_project= lu_wsf= lu_locks=
	while IFS= read -r lu_line; do
		case "$lu_line" in
		P*) lu_project=${lu_line#P} ;;
		W*) lu_wsf=${lu_line#W} ;;
		L*) lu_locks="$lu_locks${lu_line#L}
" ;;
		esac
	done <<EOF_STATE
$lu_state
EOF_STATE
	lu_want="lockfamily-$(sha8 "$lu_ws")"
	if [ "$lu_project" != "$lu_want" ] || [ "$lu_wsf" != "$lu_ws" ]; then
		lockup_why="$lu_f: project $lu_project of $lu_wsf, not this workspace's ($lu_want of $lu_ws): run \`lox up\` in $lu_ws"
		return 1
	fi
	if ! json_safe "$lu_ws"; then
		lockup_why="the workspace's path $lu_ws holds a quote, a backslash or a control character: lockfile cannot check lox up's labels; move or rename it"
		return 1
	fi
	lu_names=$(printf '%s' "$lu_locks" | awk '{ print $1 }' | sort | tr '\n' ' ')
	lu_names=${lu_names% }
	if [ -n "$lu_inst" ]; then
		case "$lu_inst" in
		*[!a-z0-9-]* | -*)
			lockup_why="--instance: not an instance name (lowercase letters, digits and -)"
			return 1
			;;
		esac
		lu_sel=$(printf '%s' "$lu_locks" | awk -v n="$lu_inst" '$1 == n')
		if [ -z "$lu_sel" ]; then
			lockup_why="lox up runs no lockfile lock $lu_inst in $lu_ws (its lockfile locks: ${lu_names:-none}): name one with --instance, or add it (lox add lockfile $lu_inst) and run \`lox up\`"
			return 1
		fi
	else
		case "$lu_names" in
		"")
			lockup_why="lox up runs no lockfile lock in $lu_ws: add one (lox add lockfile <name>), then run \`lox up\`"
			return 1
			;;
		*" "*)
			lockup_why="lox up runs several lockfile locks in $lu_ws ($lu_names): name one with --instance NAME"
			return 1
			;;
		esac
		lu_sel=$lu_locks
	fi
	# shellcheck disable=SC2086 # name, volume and group: checked words
	set -- $lu_sel
	lu_name=$1 lu_sock=$2 lu_gid=${3:-}
	lu_vol=${lu_project}_$lu_name-run
	if [ "$lu_sock" != "$lu_vol" ]; then
		lockup_why="$lu_f: lock $lu_name: socket volume $lu_sock is not lox up's $lu_vol: run \`lox up\`"
		return 1
	fi
	if [ -n "$lu_gid" ] && [ "$lu_gid" != 10030 ]; then
		lockup_why="lock $lu_name: clients group $lu_gid, this image's is 10030: update lockfile (lockfile update) or the lock's image"
		return 1
	fi
	lu_got=$(docker volume inspect --format '{{json (index .Labels "com.docker.compose.project")}}
{{json (index .Labels "com.docker.compose.volume")}}
{{json (index .Labels "dev.lockfamily.role")}}
{{json (index .Labels "dev.lockfamily.instance")}}
{{json (index .Labels "dev.lockfamily.type")}}
{{json (index .Labels "dev.lockfamily.workspace")}}' "$lu_vol" 2>/dev/null) || {
		lockup_why="lock $lu_name: no volume $lu_vol: run \`lox up\`"
		return 1
	}
	if [ "$lu_got" != "\"$lu_project\"
\"$lu_name-run\"
\"socket\"
\"$lu_name\"
\"lockfile\"
\"$lu_ws\"" ]; then
		lockup_why="lock $lu_name: volume $lu_vol is not lox up's socket volume of it (its labels): lockfile trusts none of it; run \`lox up\`"
		return 1
	fi
	# Every container that mounts the volume, running or not, must be lox
	# up's own or unable to serve a socket there. lox up's: compose ran it
	# from lox up's state directory, with the file on stdin or that
	# directory's compose.yaml (compose's project label alone is anyone's: a
	# compose file written in the workspace, run by you, would serve the
	# socket from an image of its own). Any other container, compose's or
	# not, must mount the volume read-only (an agent's, as this one): with
	# a read-write mount it could listen on the socket's path.
	lu_state_dir=$(printf '%s' "${XDG_STATE_HOME:-${HOME:-}/.local/state}/lockfamily/$lu_project" | sed -e 's#//*#/#g')
	if ! json_safe "$lu_state_dir"; then
		lockup_why="lox up's state directory $lu_state_dir holds a quote, a backslash or a control character: lockfile cannot check lox up's containers"
		return 1
	fi
	lu_ids=$(docker ps -a --no-trunc --filter "volume=$lu_vol" --format '{{.ID}}' 2>/dev/null) || {
		lockup_why="lock $lu_name: cannot list the containers of $lu_vol (docker ps)"
		return 1
	}
	if [ -n "$lu_ids" ] && printf '%s\n' "$lu_ids" | grep -vqx '[0-9a-f]\{64\}'; then
		lockup_why="lock $lu_name: cannot read the containers of $lu_vol (docker ps)"
		return 1
	fi
	for lu_id in $lu_ids; do
		# Compose's project, working directory and files, as JSON; then
		# rw or ro for each mount of the volume (its name: checked
		# characters).
		lu_c=$(docker inspect --type container -f '{{json (index .Config.Labels "com.docker.compose.project")}}
{{json (index .Config.Labels "com.docker.compose.project.working_dir")}}
{{json (index .Config.Labels "com.docker.compose.project.config_files")}}
{{range .Mounts}}{{if eq .Name "'"$lu_vol"'"}}{{if .RW}}rw {{else}}ro {{end}}{{end}}{{end}}' "$lu_id" 2>/dev/null) || {
			lockup_why="lock $lu_name: cannot read the containers of $lu_vol (docker inspect $lu_id)"
			return 1
		}
		lu_rw=$(printf '%s\n' "$lu_c" | sed -n 4p)
		lu_c=$(printf '%s\n' "$lu_c" | sed -n 1,3p)
		if [ "$lu_c" = "\"$lu_project\"
\"$lu_state_dir\"
\"-\"" ] || [ "$lu_c" = "\"$lu_project\"
\"$lu_state_dir\"
\"$lu_state_dir/compose.yaml\"" ]; then
			continue # lox up's
		fi
		# Read-only mounts only (none listed: not one docker shows by name).
		case " $lu_rw" in
		" " | *" rw "*)
			lockup_why="lock $lu_name: volume $lu_vol is mounted read-write by container $lu_id, which lox up did not start (not compose run from $lu_state_dir): lockfile trusts none of its socket; remove that container, then run \`lox up\`"
			return 1
			;;
		esac
	done
	lockup_vol=$lu_vol
}
lockup_vol= lockup_why=

# lockup_home: after lockup_volume, the home volume of that lock's console
# and the volume of its reviewed profile copy, as lox up made them
# (compose's project and volume labels), in $lockup_home and
# $lockup_profile; else why, in $lockup_why. The console runs its plugins
# from that home and reads its config from that copy (lockhub's
# internal/family/compose.go): what plugin, audit and forget change or
# read there is the console's own.
lockup_home() {
	lockup_home= lockup_profile=
	for lu_v in "$lu_name-home" profile-lockfile; do
		lu_got=$(docker volume inspect --format '{{json (index .Labels "com.docker.compose.project")}}
{{json (index .Labels "com.docker.compose.volume")}}' "${lu_project}_$lu_v" 2>/dev/null) || {
			lockup_why="lock $lu_name: no volume ${lu_project}_$lu_v: run \`lox up\`"
			return 1
		}
		if [ "$lu_got" != "\"$lu_project\"
\"$lu_v\"" ]; then
			lockup_why="lock $lu_name: volume ${lu_project}_$lu_v is not lox up's (its labels): lockfile trusts none of it; run \`lox up\`"
			return 1
		fi
	done
	lockup_home=${lu_project}_$lu_name-home
	lockup_profile=${lu_project}_profile-lockfile
}

# console_mounts: the --mount arguments of the console account's commands:
# lox up's home of the lock and its profile copy, read-only (exit 2 with
# why when there is none).
console_mounts() {
	command -v docker >/dev/null 2>&1 || die "docker is required: lockfile runs in Docker (docs/docker.md)"
	if ! lockup_volume "$instance" || ! lockup_home; then
		say "$lockup_why"
		say "$cmd works on the console that \`lox up\` runs: its plugins, audit and secrets are in that console's home"
		exit 2
	fi
}

# as_workspace ARGS...: run as you, with the workspace's profile directory
# <workspace>/.lockfile only (made 0700 when missing), at its own path. The
# workspace is the one the agent commands reach (the nearest directory up
# from here whose .lockfamily holds up.json), else, before the first lox
# up, the nearest one that holds .lockfamily/ (where lox add wrote
# lockfamily.yaml), else this directory, where lox add would make it.
as_workspace() {
	[ -n "$here" ] || die "the current directory no longer exists: cd to the workspace"
	ws=
	# profile add --project DIR: that workspace, passed on as an absolute
	# path (the command runs from /).
	if [ "${1:-}" = profile ] && has_flag --project "$@"; then
		n=$#
		take=
		done_opts=
		for a in "$@"; do
			if [ -n "$done_opts" ]; then
				set -- "$@" "$a"
				continue
			fi
			if [ -n "$take" ]; then
				a=--project=$a
				take=
			fi
			case "$a" in
			--) done_opts=1 ;;
			--project)
				take=1
				continue
				;;
			--project=*)
				p=${a#--project=}
				[ -n "$p" ] && [ -d "$p" ] || die "--project: not a directory"
				ws=$(cd "$p" && pwd -P) || die "--project: not a directory"
				a=--project=$ws
				;;
			esac
			set -- "$@" "$a"
		done
		shift "$n"
		[ -z "$take" ] || die "--project: name the workspace directory"
	fi
	for want in up.json ""; do
		[ -z "$ws" ] || break
		d=$here
		while :; do
			if [ -e "$d/.lockfamily/$want" ] || [ -L "$d/.lockfamily/$want" ] || [ -L "$d/.lockfamily" ]; then
				ws=$d
				break 2
			fi
			[ "$d" = / ] && break
			d=$(dirname "$d")
		done
	done
	[ -n "$ws" ] || ws=$here
	pd=$ws/.lockfile
	[ ! -L "$pd" ] || die "$pd is a link: lox up copies none; remove it"
	if [ ! -e "$pd" ]; then
		(umask 077 && mkdir "$pd") || die "cannot make $pd"
	fi
	[ -d "$pd" ] || die "$pd is not a directory: lox up copies none"
	mountable "$pd"
	docker_run "$tty" --user "$(id -u):$(id -g)" -e LOCKFILE_WORKSPACE="$ws" \
		--mount "type=bind,src=$pd,dst=$pd" -w / "$image" "$@"
}

# --instance NAME (or --instance=NAME): the launcher's own option of the
# agent commands, which of lox up's lockfile locks when the workspace has
# several. Taken out of the command line ("--" ends the options).
instance=
case "${1:-}" in
mcp | doctor | status | sources | plugins | plan | run | answers | release | plugin | audit | forget)
	n=$#
	take=
	done_opts=
	for a in "$@"; do
		if [ -n "$done_opts" ]; then
			set -- "$@" "$a"
			continue
		fi
		if [ -n "$take" ]; then
			instance=$a
			take=
			continue
		fi
		case "$a" in
		--) done_opts=1 ;;
		--instance)
			take=1
			continue
			;;
		--instance=*)
			instance=${a#--instance=}
			continue
			;;
		esac
		set -- "$@" "$a"
	done
	shift "$n"
	[ -z "$take" ] || die "--instance: name the lock (lox up's instance)"
	;;
esac

# lockup_mount: lox up's socket volume of this workspace's lockfile lock,
# as the agent commands mount it, or the reason there is none (exit 2, as
# a client finding no console).
lockup_mount() {
	command -v docker >/dev/null 2>&1 || die "docker is required: lockfile runs in Docker (docs/docker.md)"
	lockup_volume "$instance" || {
		say "$lockup_why"
		exit 2
	}
	mount="type=volume,src=$lockup_vol,dst=/run/lockfile,readonly"
}

cmd="${1:-}"
case "$cmd" in
update)
	shift
	update "$@"
	;;
version | --version)
	printf 'lockfile launcher %s (image %s)\n' "$launcher_version" "$image"
	docker_run "$image" version
	;;
console)
	command -v docker >/dev/null 2>&1 || die "docker is required: lockfile runs in Docker (docs/docker.md)"
	seccomp
	# VAULT_CACERT: the file the vault CLI checks Vault's certificate
	# against, mounted read-only at its own path.
	cacert=
	if [ -n "${VAULT_CACERT:-}" ]; then
		case "$VAULT_CACERT" in /*) cacert=$VAULT_CACERT ;; *) cacert="$(pwd -P)/$VAULT_CACERT" ;; esac
		[ -f "$cacert" ] || die "VAULT_CACERT: no file $cacert"
		mountable "$cacert"
	fi
	# One console container per profile, so that two can run.
	name="${LOCKFILE_CONSOLE_NAME:-lockfile-console-$(flag_value --profile "$@" | cksum | awk '{ print $1 }')}"
	# A console that ended without --rm keeps the name: a stopped one is only in the way.
	if [ "$(docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null)" = false ]; then
		docker rm "$name" >/dev/null
	fi
	# No log driver: with a terminal, docker's json-file log would keep every
	# screen of the console for anyone who runs docker logs. The console
	# holds the credentials and runs the plugins: no capability, no
	# privilege gain (the plugin sandbox sets no_new_privs itself), a
	# read-only root with a small /tmp (the fetched files are in its home),
	# bounded processes and memory (a plugin may take up to 2 GB).
	# host.docker.internal is this machine.
	migrate_ids -v lockfile-run:/run/lockfile -v lockfile-home:/home/lockfile
	docker_run "$tty" --name "$name" --log-driver none --user lockfile \
		--security-opt seccomp="$seccomp_profile" --cap-drop=ALL --security-opt no-new-privileges \
		--read-only --tmpfs /tmp:rw,nosuid,nodev,noexec,size=64m --pids-limit 512 --memory 4g \
		--add-host=host.docker.internal:host-gateway -e VAULT_ADDR -e VAULT_NAMESPACE \
		${cacert:+-v} ${cacert:+"$cacert:$cacert:ro"} ${cacert:+-e} ${cacert:+"VAULT_CACERT=$cacert"} \
		-v lockfile-run:/run/lockfile -v lockfile-home:/home/lockfile "$image" "$@"
	;;
doctor)
	if has_flag --fix "$@"; then
		# --fix wires your agents: it writes their files, as you.
		as_you "$@"
	fi
	seccomp
	# The checks of the console lox up runs: its socket, its home and its
	# profile copy. Without lox up they run without them and say so.
	if command -v docker >/dev/null 2>&1 && lockup_volume "$instance" && lockup_home; then
		docker_run "$tty" --user lockfile --security-opt seccomp="$seccomp_profile" \
			--mount "type=volume,src=$lockup_vol,dst=/run/lockfile,readonly" \
			--mount "type=volume,src=$lockup_home,dst=/home/lockfile" \
			--mount "type=volume,src=$lockup_profile,dst=/home/lockfile/.config/lockfile,readonly" "$image" "$@"
	fi
	[ -z "$lockup_why" ] || say "$lockup_why"
	docker_run "$tty" --user lockfile --security-opt seccomp="$seccomp_profile" "$image" "$@"
	;;
profile | marketplace)
	as_workspace "$@"
	;;
plugin | audit | forget)
	console_mounts
	docker_run "$tty" --user lockfile \
		--mount "type=volume,src=$lockup_home,dst=/home/lockfile" \
		--mount "type=volume,src=$lockup_profile,dst=/home/lockfile/.config/lockfile,readonly" "$image" "$@"
	;;
init)
	as_you "$@"
	;;
mcp)
	# The agent speaks MCP on stdin and stdout: no terminal.
	lockup_mount
	docker_run -i --mount "$mount" "$image" "$@"
	;;
status | sources | plugins | plan | run | answers | release)
	lockup_mount
	docker_run "$tty" --mount "$mount" "$image" "$@"
	;;
*)
	docker_run "$tty" "$image" "$@"
	;;
esac
